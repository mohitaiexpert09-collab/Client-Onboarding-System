# Copy to .env.local and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Connect)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dropbox Sign (HelloSign) — alternative e-sign, optional
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=

# Resend
RESEND_API_KEY=

# Inngest (optional for local dev — the Inngest dev server works without keys)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Slack (Phase 2)
SLACK_BOT_TOKEN=

# OpenAI (AI assists)
OPENAI_API_KEY=
OPENAI_MODEL=
